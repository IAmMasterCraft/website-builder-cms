#!/usr/bin/env bash
# Lint every PHP file, run the unit/DB tests, then the end-to-end smoke test.
# Usage: bin/check   (PHP binary can be overridden with PHP=/path/to/php)
set -euo pipefail
cd "$(dirname "$0")/.."
PHP="${PHP:-php}"

echo "== Lint"
lint_errors=$(find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 "$PHP" -l 2>&1 | grep -v '^No syntax errors' || true)
for f in bin/migrate bin/make-admin bin/cron bin/demo bin/backup bin/restore bin/docs-html; do
  out=$("$PHP" -l "$f" 2>&1) || lint_errors+=$'\n'"$out"
done
for f in bin/check bin/package dev-tools/htaccess-check.sh; do out=$(bash -n "$f" 2>&1) || lint_errors+=$'\n'"$out"; done
if [ -n "$lint_errors" ]; then echo "$lint_errors"; exit 1; fi
echo "all PHP files lint"

echo "== Secrets"
# config files, dumps and keys must never be tracked; no hard-coded passwords or keys in tracked PHP.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  tracked=$(git ls-files | grep -E '^config\.php$|^tests/config\.test\.php$|^storage/install-token$|\.(sql\.gz|pem|key|p12)$|^(storage|public)/.*\.sql$|(^|/)\.env|^storage/(backups|logs|mail|originals|variants)/[^.]' || true)
  literals=$(git grep -nE "'(pass|password|app_key|secret|smtp_pass)'[[:space:]]*=>[[:space:]]*'[^' ]{12,}'" -- '*.php' ':!config.example.php' ':!tests/config.test.example.php' ':!tests/*' ':!vendor/*' || true)
  if [ -n "$tracked$literals" ]; then echo "Secrets or private files are tracked:"; echo "$tracked"; echo "$literals"; exit 1; fi
  echo "no secrets tracked"
else
  echo "not a git checkout: skipped"
fi

echo "== Unit and database tests"
"$PHP" tests/run.php | tail -n 1

echo "== Smoke test (php -S)"
"$PHP" tests/smoke.php | tail -n 1
