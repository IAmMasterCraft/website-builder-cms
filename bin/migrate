#!/usr/bin/env php
<?php
declare(strict_types=1);

// Apply pending migrations: php bin/migrate [--status]
if (PHP_SAPI !== 'cli') {
    exit(1);
}
require __DIR__ . '/../src/load.php';

if (!is_file(config_path())) {
    fwrite(STDERR, "No config file at " . config_path() . ". Run the /install wizard or copy config.example.php.\n");
    exit(1);
}
$pdo = db();
if (in_array('--status', $argv, true)) {
    $done = [];
    try {
        $done = $pdo->query('SELECT version FROM schema_migrations')->fetchAll(PDO::FETCH_COLUMN);
    } catch (PDOException) {
    }
    foreach (migration_files() as $f) {
        echo (in_array($f, $done, true) ? '[x] ' : '[ ] ') . $f . "\n";
    }
    exit(0);
}
$applied = migrate($pdo, static function (string $m): void {
    echo $m, "\n";
});
echo $applied ? count($applied) . " migration(s) applied.\n" : "Nothing to migrate.\n";
if (($problem = app_key_problem()) !== null) {
    fwrite(STDERR, "Warning: $problem The site refuses to run until it is fixed.\n");
    exit(0);
}
settings_all([]);
if (secret_upgrade_smtp_password()) {
    echo "Stored SMTP password re-encrypted with the new storage key.\n";
}
// Files of members-only items become members-only (and vice versa); safe to run every time.
if (($moved = media_sync_all()) > 0) {
    echo "$moved media file(s) moved to match the visibility of the items that use them.\n";
}
