#!/usr/bin/env bash
# Build the upload archive for any host (see docs/getting-the-code.md).
#   bin/package [--zip] [git-ref]   default: HEAD  ->  dist/gather-<date>-<commit>.tar.gz
#   --zip also writes dist/gather-<date>-<commit>.zip (cPanel and Plesk file
#   managers extract .zip with one click). Both hold one top folder, gather/.
#   --flat (with --zip) writes the zip without the top folder instead, for
#   extracting straight into an existing folder such as public_html.
# Packages committed files only (git archive), then removes everything the
# server does not need: config.php, storage contents, tests, dev tools,
# developer notes and docs/ (read those on GitHub or in a clone). macOS
# metadata (._* files, xattrs) is kept out with COPYFILE_DISABLE=1 and
# tar --no-xattrs --no-mac-metadata.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
zip=0
flat=0
ref=HEAD
for arg in "$@"; do
  case "$arg" in
    --zip) zip=1 ;;
    --flat) flat=1 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    -*) echo "unknown option: $arg" >&2; exit 1 ;;
    *) ref="$arg" ;;
  esac
done
if [ "$flat" = 1 ] && [ "$zip" = 0 ]; then echo "--flat needs --zip" >&2; exit 1; fi
if [ "$zip" = 1 ]; then command -v zip >/dev/null || { echo "zip is needed for --zip" >&2; exit 1; }; fi
command -v git >/dev/null || { echo "git is needed to package" >&2; exit 1; }
git rev-parse --verify --quiet "$ref^{commit}" >/dev/null || { echo "unknown git ref: $ref" >&2; exit 1; }
if [ "$ref" = "HEAD" ] && [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "note: uncommitted changes are NOT included (the archive is built from $ref)" >&2
fi
commit_full=$(git rev-parse "$ref")
name="gather-$(date -u +%Y%m%d)-${commit_full:0:7}"
zipname="$name.zip"
[ "$flat" = 1 ] && zipname="$name-flat.zip"
stage=$(mktemp -d "${TMPDIR:-/tmp}/gather-package.XXXXXX")
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/gather" "$ROOT/dist"

git archive --format=tar "$ref" | tar -x -C "$stage/gather"

cd "$stage/gather"
# Never shipped: secrets, runtime data, tests, dev tooling, developer notes.
rm -rf config.php tests dev-tools docs .gitignore BUILD-NOTES.md bin/check bin/package demo-assets/make-radio-demo.php
find storage public/uploads -mindepth 2 -type f ! -name '.gitkeep' ! -name '.htaccess' -delete 2>/dev/null || true
find public/uploads -mindepth 1 -type f ! -name '.gitkeep' ! -name '.htaccess' -delete
find . \( -name '._*' -o -name '.DS_Store' \) -type f -delete
printf 'commit=%s\nbuilt=%s\n' "$commit_full" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > VERSION

cd "$stage"
COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata --exclude='._*' --exclude='.DS_Store' -czf "$ROOT/dist/$name.tar.gz" gather

if [ "$zip" = 1 ]; then
  rm -f "$ROOT/dist/$zipname"
  # -X: no extra uid/gid fields; Unix permission bits are kept for unzip.
  if [ "$flat" = 1 ]; then
    (cd "$stage/gather" && zip -qrX "$ROOT/dist/$zipname" . -x '._*' '*/._*' '.DS_Store' '*/.DS_Store')
  else
    (cd "$stage" && zip -qrX "$ROOT/dist/$zipname" gather -x '*/._*' '*/.DS_Store')
  fi
fi

# Show what went in, and refuse to finish if anything private slipped through.
private='^gather/config\.php$|^gather/storage/install-token$|^gather/tests/|^gather/dev-tools/|(^|/)\._|\.DS_Store$|^gather/storage/[^/]+/[^.][^/]*$|^gather/\.git/'
check_list() { # $1 = archive, $2 = file list
  local bad
  bad=$(printf '%s\n' "$2" | grep -E "$private" || true)
  if [ -n "$bad" ]; then
    echo "refusing: private files in $1:" >&2
    echo "$bad" >&2
    rm -f "$ROOT/dist/$name.tar.gz" "$ROOT/dist/$zipname"
    exit 1
  fi
  printf 'dist/%s  (%s files, %s)\n' "$1" "$(printf '%s\n' "$2" | grep -vc '/$')" "$(du -h "$ROOT/dist/$1" | cut -f1)"
}
check_list "$name.tar.gz" "$(tar -tzf "$ROOT/dist/$name.tar.gz")"
if [ "$zip" = 1 ]; then
  # Check the flat zip with the same rules by adding the folder name back.
  zlist=$(unzip -Z1 "$ROOT/dist/$zipname")
  [ "$flat" = 1 ] && zlist=$(printf '%s\n' "$zlist" | sed 's#^#gather/#')
  check_list "$zipname" "$zlist"
fi
